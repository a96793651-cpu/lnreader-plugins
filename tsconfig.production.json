{
  "compilerOptions": {
    "jsx": "react",
    "target": "ES5",
    "module": "CommonJS",
    "moduleResolution": "node10",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@plugins/*": ["./plugins/*"],
      "@libs/*": ["./src/libs/*"]
    },

    "resolveJsonModule": true,

    "rootDir": "./plugins",
    "outDir": "./.js/plugins",

    "allowJs": true,
    "checkJs": false,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "skipLibCheck": true,

    "noCheck": true,
    "noResolve": true
  },

  "include": [
    "./plugins/**/*.ts",
    "./plugins/**/*.tsx"
  ],

  "exclude": [
    "./plugins/**/*.broken.ts",
    "./plugins/multisrc/*",
    "./.js/**/*",
    "scripts/**",
    "docs/**",
    "public/**",
    ".github/**",
    ".husky/**",
    "node_modules/**"
  ]
}
